# Hanga API — Environment variables
# Copy this to .env and fill in actual values.

# --- Firebase / GCP ---
HANGA_GCP_PROJECT_ID=your-gcp-project-id
HANGA_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Gemini / Gemma ---
HANGA_GEMINI_API_KEY=your-gemini-api-key
HANGA_GEMMA_MODEL=gemma-3-27b-it
HANGA_GEMINI_FLASH_MODEL=gemini-2.0-flash

# --- Demo Mode ---
HANGA_DEMO_MODE=true
HANGA_DEMO_DATE=2026-10-10
HANGA_DEMO_SHOP_ID=warung-bu-sari

# --- CORS ---
HANGA_CORS_ORIGINS=["http://localhost:3000"]

# --- Vision extraction (Gemma 4 multimodal, AI Studio free tier) ---
# Confirm the exact model ID via client.models.list() in AI Studio.
HANGA_VISION_MODEL=gemma-4-27b-it
